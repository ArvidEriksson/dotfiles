/* Spotlight Clear — heavier glass, brighter selection */

configuration {
    show-icons:     true;
    icon-theme:     "Flat-Remix-Blue-Dark";
    hover-select:   true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

* {
    font:   "Adwaita Sans 12";

    bg-window:      rgba(20, 20, 22, 0.42);
    bg-select:      rgba(255, 255, 255, 0.20);
    hairline:       rgba(255, 255, 255, 0.08);
    border-soft:    rgba(255, 255, 255, 0.18);

    fg0:    #FFFFFF;
    fg1:    #FFFFFF;
    fg2:    rgba(255, 255, 255, 0.50);

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg-window;
    location:           center;
    width:              720;
    y-offset:           -180;
    border:             1px solid;
    border-color:       @border-soft;
    border-radius:      16px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    font:       "Adwaita Sans 19";
    padding:    16px 20px;
    spacing:    14px;
    children:   [ textbox-search, entry ];
}

textbox-search {
    expand:     false;
    str:        "";
    font:       "JetBrainsMono Nerd Font 15";
    text-color: @fg2;
    padding:    0 2px 0 2px;
}

textbox-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:               inherit;
    placeholder:        "Search";
    placeholder-color:  @fg2;
    text-color:         @fg1;
}

listview {
    lines:          9;
    columns:        1;
    fixed-height:   true;
    padding:        8px 10px 10px 10px;
    spacing:        3px;
    border:         1px 0 0 0 solid;
    border-color:   @hairline;
    scrollbar:      false;
}

element {
    padding:        8px 12px;
    spacing:        12px;
    border-radius:  9px;
    background-color: transparent;
    cursor:         pointer;
}

element normal active,
element alternate active {
    text-color: @fg0;
}

element selected normal,
element selected active,
element selected urgent {
    background-color:   @bg-select;
    text-color:         @fg1;
}

element-icon {
    size:   1.4em;
}

element-text {
    text-color: inherit;
    font:       "Adwaita Sans 12";
}

message {
    padding:        8px 20px;
    border:         1px 0 0 0 solid;
    border-color:   @hairline;
}

textbox {
    padding:    6px 10px;
    text-color: @fg2;
}
