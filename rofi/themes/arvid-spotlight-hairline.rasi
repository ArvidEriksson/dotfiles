/* Spotlight Hairline — outlined selection, no filled block */

configuration {
    show-icons:     true;
    icon-theme:     "Flat-Remix-Blue-Dark";
    hover-select:   true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

* {
    font:   "Adwaita Sans 12";

    bg-window:      rgba(24, 24, 26, 0.60);
    bg-select:      rgba(255, 255, 255, 0.06);
    select-edge:    rgba(255, 255, 255, 0.28);
    hairline:       rgba(255, 255, 255, 0.09);
    border-soft:    rgba(255, 255, 255, 0.14);

    fg0:    rgba(255, 255, 255, 0.82);
    fg1:    #FFFFFF;
    fg2:    rgba(255, 255, 255, 0.45);

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg-window;
    location:           center;
    width:              700;
    y-offset:           -180;
    border:             1px solid;
    border-color:       @border-soft;
    border-radius:      14px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    font:       "Adwaita Sans 18";
    padding:    15px 18px;
    spacing:    12px;
    children:   [ textbox-search, entry ];
}

textbox-search {
    expand:     false;
    str:        "";
    font:       "JetBrainsMono Nerd Font 15";
    text-color: @fg2;
    padding:    0 2px 0 2px;
}

textbox-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:               inherit;
    placeholder:        "Search";
    placeholder-color:  @fg2;
    text-color:         @fg1;
}

listview {
    lines:          9;
    columns:        1;
    fixed-height:   true;
    padding:        7px 9px 9px 9px;
    spacing:        2px;
    border:         1px 0 0 0 solid;
    border-color:   @hairline;
    scrollbar:      false;
}

element {
    padding:        7px 11px;
    spacing:        12px;
    border-radius:  8px;
    border:         1px solid;
    border-color:   transparent;
    background-color: transparent;
    cursor:         pointer;
}

element normal active,
element alternate active {
    text-color: @fg0;
}

element selected normal,
element selected active,
element selected urgent {
    background-color:   @bg-select;
    border-color:       @select-edge;
    text-color:         @fg1;
}

element-icon {
    size:   1.35em;
}

element-text {
    text-color: inherit;
    font:       "Adwaita Sans 12";
}

message {
    padding:        8px 18px;
    border:         1px 0 0 0 solid;
    border-color:   @hairline;
}

textbox {
    padding:    6px 10px;
    text-color: @fg2;
}
