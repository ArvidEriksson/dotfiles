// ### DEFAULT Laptop  - Top ### //
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 0,
"margin-left": 0,
"margin-right": 0,

"modules-left": [
	"custom/separator#blank",
	"custom/cava_mviz",
	"custom/separator#blank",
	"custom/playerctl",
	"custom/separator#blank",
	"hyprland/window",
	],

"modules-center": [
	"custom/separator#blank",
"hyprland/workspaces#rw",
	"clock",
	"group/notify",
	"custom/weather2",
	"idle_inhibitor",	
	],

"modules-right": [
	"tray",
	"group/laptop",
	"group/mobo_drawer",
	"group/audio",
	"custom/nightlight",
	"custom/keyboard",
	"custom/power",
	],
}
