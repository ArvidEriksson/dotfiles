/* Waybar Modules Extras */

/* This is where you can add Extra Modules you wish. copy.sh will try to restore*/
/* this file along with the unique configs and styles. */
/* IMPORTANT, be mindful with , or ". else waybar will not start */

{

"custom/transparency": {
	"return-type": "json",
	"exec": "$HOME/.config/hypr/scripts/ToggleTransparency.sh status",
	"interval": 3,
	"signal": 3,
	"format": "{text}",
	"min-length": 2,
	"on-click": "$HOME/.config/hypr/scripts/ToggleTransparency.sh toggle",
	"tooltip": true,
	"escape": false
},

}