{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(tr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)",
      "Bash(ssh gpu-vm:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/arvid/.claude/hooks/log-skill-use.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/arvid/.claude/hooks/dashboard-with-skill.sh"
  },
  "enabledPlugins": {
    "claude-dashboard@claude-dashboard": true,
    "superpowers@claude-plugins-official": true,
    "studio555@studio555-plugins": true
  },
  "extraKnownMarketplaces": {
    "claude-dashboard": {
      "source": {
        "source": "github",
        "repo": "uppinote20/claude-dashboard"
      }
    },
    "studio555-plugins": {
      "source": {
        "source": "directory",
        "path": "/home/arvid/studio555-ai-skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "custom:panda",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
